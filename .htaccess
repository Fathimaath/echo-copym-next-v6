RewriteEngine On
RewriteBase /

# Disable SPA fallback — cPanel often enables this, causing homepage for unknown URLs
FallbackResource disabled

# Disable directory listing
Options -Indexes

# Use custom 404 page for all 404 errors (internal sub-request, serves /404/index.html)
ErrorDocument 404 /404/

# Block PHP scripts (admin is React, not PHP)
<FilesMatch "\.(php|phtml|pht|php3|php4|php5|php7|phar|suspected)$">
  Deny from all
</FilesMatch>
<FilesMatch "^\.htaccess$">
  Deny from all
</FilesMatch>

# Admin is a separate React SPA — let it handle its own routing
RewriteCond %{REQUEST_URI} ^/admin
RewriteRule ^ - [L]

# Block known malicious paths and sensitive files
RewriteRule ^special/ - [R=404,L]
RewriteRule ^(wp-|wp-admin|wp-login|wp-content|administrator) - [F,L]
RewriteRule ^(\.env|\.git|\.svn|composer\.json|package-lock\.json) - [F,L]

# Force 404 status for direct access to 404.html (prevents duplicate serving)
RewriteRule ^404\.html$ - [R=404,L]

# Exclude 404 directory and internal Next.js paths from rewriting
RewriteRule ^404 - [L]
RewriteRule ^_not-found - [L]

# If the request maps to an existing file or directory, serve it immediately
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Add trailing slash for clean URLs (Next.js trailingSlash: true)
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteCond %{REQUEST_URI} !/$
RewriteRule (.*) /$1/ [R=301,L]

# After trailing slash is added, serve the index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)/$ /$1/index.html [L]

# Compression is handled by cPanel (Brotli/mod_deflate at server level)

# ----- CACHING -----
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|avif|ico|css|js|woff2?|mp4|webm|json|xml)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# ----- SECURITY HEADERS -----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>
