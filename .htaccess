RewriteEngine On
RewriteBase /

# Disable SPA fallback — cPanel often enables this, causing homepage for unknown URLs
FallbackResource disabled

# 404 - return proper status code (not 200)
# Next.js with trailingSlash: true exports 404 as /404/index.html
ErrorDocument 404 /404/

# Exclude 404 and internal Next.js paths from rewriting
RewriteRule ^404 - [L]
RewriteRule ^_not-found - [L]

# Add trailing slash for clean URLs (Next.js trailingSlash: true)
# Apache serves /path/ → /path/index.html automatically via DirectoryIndex
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteCond %{REQUEST_URI} !/$
RewriteRule (.*) /$1/ [R=301,L]

# ----- COMPRESSION -----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
  RemoveOutputFilter html
</IfModule>

# ----- CACHING -----
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|avif|ico|css|js|woff2?)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
